# 默认：文本文件统一用 LF 存取，避免跨平台换行符抖动
* text=auto eol=lf

# ── 二进制文件：禁止任何换行符转换 ───────────────────────
*.woff2  binary
*.woff   binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.zip    binary

# ── 明确标记为文本 ───────────────────────────────────────
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.ps1    text eol=crlf

# ── 让 git diff / GitHub 语言统计更准确 ──────────────────
*.svg    -diff
*.woff2  -diff
